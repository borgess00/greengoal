# ---- Públicas (podem ir ao navegador) ----
# Preenchidas automaticamente pelo Lovable Cloud.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=chave-anon-publica

# ---- Somente servidor (configure como SEGREDOS, nunca no repositório) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
API_FOOTBALL_KEY=
# IA das análises: use UMA das duas. Se as duas existirem, o Claude é usado.
ANTHROPIC_API_KEY=
# Opcional: modelo do Claude (padrão claude-opus-5-5; ex.: claude-sonnet-5-5, claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Opcional: modelo da OpenAI (padrão gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Pagamentos pelo Asaas (sem ASAAS_API_KEY o site usa o checkout demonstrativo)
ASAAS_API_KEY=
# Token do webhook (32 a 255 caracteres, sem espaços; NÃO use a chave da API)
ASAAS_WEBHOOK_TOKEN=
# Opcional: "sandbox" para o ambiente de testes do Asaas
# ASAAS_ENV=sandbox
